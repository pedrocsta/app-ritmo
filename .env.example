# Supabase Project URL and public publishable key (browser authentication).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Data API access ONLY on the server (never prefix with NEXT_PUBLIC_).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# The one permitted user's UID from Supabase Authentication > Users.
# This is NOT the email address; it's the UUID shown in the users table.
OWNER_USER_ID=00000000-0000-4000-8000-000000000000
